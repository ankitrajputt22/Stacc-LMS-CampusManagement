# Local configuration for Stacc. Copy this file to .env and fill in the empty values.
# .env is ignored by Git. Never commit real passwords or secrets.
#
# Docker Compose reads .env by itself. When the backend is run directly with Maven, the same
# variables must be set in your shell or IDE, because Spring Boot does not read .env.

# --- Database ---
# Where the backend finds MySQL when it is run directly. Docker ignores MYSQL_HOST: inside
# Docker the backend always reaches the database as "mysql".
MYSQL_HOST=localhost
# The MySQL port on this machine. With Docker this is the port the MySQL container is
# published on. Change it if 3306 is already used, for example by a local MySQL.
MYSQL_PORT=3306
MYSQL_DATABASE=stacc
# The account the backend connects with. With Docker it is created on the first start.
# It must not be "root".
MYSQL_USER=stacc
MYSQL_PASSWORD=
# Docker only: the password of the MySQL root account inside the container.
MYSQL_ROOT_PASSWORD=

# --- Access tokens ---
# The signing secret: Base64 text for at least 32 random bytes. Create one with
#   openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15

# --- File storage (MinIO) ---
# Docker: the MinIO account. The backend in Docker uses it to reach its private bucket.
# The user name needs 3 characters or more and the password 8 or more; use a long random one,
# for example from: openssl rand -hex 24
MINIO_ROOT_USER=stacc-minio
MINIO_ROOT_PASSWORD=
# Where the backend finds storage when it is run directly, with the same account as above.
# Docker ignores these three and uses the minio service.
STACC_STORAGE_ENDPOINT=http://localhost:9000
STACC_STORAGE_ACCESS_KEY=stacc-minio
STACC_STORAGE_SECRET_KEY=
# The one private bucket for study materials and submission files. It is created on the first upload.
STACC_STORAGE_BUCKET=stacc-materials
# The largest study-material or submission file, the most files in one submission attempt, and Spring's
# hard limit for a whole upload request (all optional).
# STACC_MATERIAL_MAX_FILE_SIZE=25MB
# STACC_SUBMISSION_MAX_FILES=3
# STACC_UPLOAD_MAX_REQUEST_SIZE=80MB

# --- Frontend dev server ---
# The web address that may call the API from a browser when the frontend runs with
# "npm run dev". Exact addresses only, separated by commas. A wildcard (*) is refused.
# The Docker frontend does not need this: there the page and the API share one address.
FRONTEND_ORIGIN=http://localhost:5173

# --- Local test data (optional, development only) ---
# Set SPRING_PROFILES_ACTIVE=dev-seed to fill a local database with demo data and test accounts
# (see docs/local-test-data.md). Every test account gets the password below: choose your own, at
# least 8 characters, and never reuse a real password. Leave both empty for normal use.
# SPRING_PROFILES_ACTIVE=dev-seed
STACC_TEST_PASSWORD=

# --- Docker only: ports on this machine (optional) ---
# FRONTEND_PORT=3000
# BACKEND_PORT=8080
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# --- AI learning features (optional) ---
# Off unless set to true. They also need the "ai" Docker profile (docker compose --profile ai up) and local models
# pulled into Ollama once; see docs/ai-learning.md. No commercial AI account is needed or used.
AI_ENABLED=false
# The shared secret the backend sends to the internal AI service: at least 32 characters, the same for both. Create
# one with: openssl rand -hex 32
STACC_AI_INTERNAL_TOKEN=
# The local Ollama models to use. Any chat model and embedding model you have pulled works; these are examples only.
# AI_CHAT_MODEL=llama3.2:3b
# AI_EMBEDDING_MODEL=nomic-embed-text
# "ollama" (default) or "fake" (testing the wiring only: it quotes course text and needs no model).
# AI_PROVIDER=ollama
# Where the backend finds the AI service when the backend runs with Maven. Docker uses the ai-service service.
# AI_SERVICE_URL=http://localhost:8095
